	<Button name="128ButtonRedCustom" virtual="true">
		<Size x="185" y="52"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Left" file="Interface\Buttons\128RedButton">
					<Size x="52" y="52"/>
					<TexCoords left="0.763672" right="0.986328" top="0.444824" bottom="0.507324"/>
					<Anchors>
						<Anchor point="TOPLEFT"/>
						<Anchor point="BOTTOMLEFT"/>
					</Anchors>
				</Texture>
				<Texture parentKey="Right" file="Interface\Buttons\128RedButton">
					<Size x="133" y="52"/>
					<TexCoords left="0.00195312" right="0.572266" top="0.25439" bottom="0.316895"/>
					<Anchors>
						<Anchor point="TOPRIGHT"/>
						<Anchor point="BOTTOMRIGHT"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>

		<Scripts>
			<OnMouseUp>
				if ( self:IsEnabled() ) then
					self.Left:SetTexCoord(0.763672, 0.986328, 0.444824, 0.507324)
					self.Right:SetTexCoord(0.00195312, 0.572266, 0.25439, 0.316895)
				end
			</OnMouseUp>
			<OnMouseDown>
				if ( self:IsEnabled() ) then
					self.Left:SetTexCoord(0.482422, 0.705078, 0.508301, 0.570801)
					self.Right:SetTexCoord(0.00195312, 0.572266, 0.381348, 0.443848)
				end
			</OnMouseDown>
			<OnDisable>
				self.Left:SetTexCoord(0.255859, 0.478516, 0.508301, 0.570801)
				self.Right:SetTexCoord(0.00195312, 0.572266, 0.317871, 0.380371)
			</OnDisable>
			<OnEnable>
				self.Left:SetTexCoord(0.763672, 0.986328, 0.444824, 0.507324)
				self.Right:SetTexCoord(0.00195312, 0.572266, 0.25439, 0.316895)
			</OnEnable>
		</Scripts>
		<ButtonText>
			<Anchors>
				<Anchor point="CENTER">

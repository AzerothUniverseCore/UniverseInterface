<Script file="GlueButtons.lua"/>
	<Button name="GlueButtonMasterTemplate" virtual="true" hidden="false">
		<Scripts>
			<OnLoad>
				self.pulseCounter = 0;
				self.pulseSign = 1;
			</OnLoad>
			<OnUpdate>
				GlueButtonMaster_OnUpdate(self, elapsed);
			</OnUpdate>
			<OnEnter>
				_G[self:GetName().."Rays"]:Show();
				self.startPulse = 1;
			</OnEnter>
			<OnLeave>
				_G[self:GetName().."Rays"]:Hide();
				self.startPulse = nil;
			</OnLeave>
		</Scripts>
	</Button>

